{
  "name": "discord-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bot de Discord y API con Express y MongoDB",
  "scripts": {
    "host:prepare": "node scripts/host-pc.mjs prepare",
    "host:check": "node scripts/host-pc.mjs check",
    "host:pc": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-host-pc.ps1",
    "host:stop": "node scripts/host-pc.mjs stop",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "register:commands": "tsx --env-file-if-exists=.env scripts/register-commands.ts",
    "probe:youtube": "tsx scripts/probe-youtube.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "discord.js": "^14.22.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "ffmpeg-static": "5.3.0",
    "mongodb": "6.20.0",
    "mongoose": "^8.19.1",
    "opusscript": "0.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
