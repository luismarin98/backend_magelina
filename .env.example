NODE_ENV=development
# Registros de peticiones y actividad en consola, sin cuerpos, cookies ni credenciales.
REQUEST_LOGGING=true
PORT=3000
DASHBOARD_ORIGIN=http://localhost:5173
TRUST_PROXY=false
BIND_HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/discord_dashboard
# Opcional: DNS para las consultas de Node, sin modificar la red del sistema.
# DNS_SERVERS=1.1.1.1,8.8.8.8
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Desarrollo: destino exclusivo para actualizar comandos. En producción se publican globalmente.
DISCORD_TEST_GUILD_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Clave aleatoria privada de al menos 32 caracteres, con 2 mayusculas, 2 minusculas, 2 numeros y 2 simbolos.
SESSION_SECRET=
BOT_OWNER_IDS=
BOT_OPERATOR_IDS=

# Opcional: clave gratuita de Audius para ampliar los limites de consultas.
AUDIUS_API_KEY=
# Experimental: instala el extractor antes de activar. No requiere una API key de YouTube.
YOUTUBE_EXPERIMENTAL=false
# Ruta absoluta opcional; por defecto backend/.tools/yt-dlp.exe (Windows).
# YTDLP_PATH=C:/ruta/yt-dlp.exe
